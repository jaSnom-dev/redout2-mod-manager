<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Redout2ModManager</AssemblyName>
    <Version>1.1.2</Version>
    <RootNamespace>Redout2ModManager</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <!-- The manager scans unencrypted PAK indexes only and never decodes asset payloads. -->
    <PackageReference Include="Fmod5Sharp" Version="3.1.0" ExcludeAssets="all" />
    <PackageReference Include="IndexRange" Version="1.1.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" ExcludeAssets="all" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" ExcludeAssets="all" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" ExcludeAssets="all" />
    <PackageReference Include="VGAudio" Version="2.2.1" ExcludeAssets="all" />
    <PackageReference Include="FixedMathSharp" Version="4.0.1" ExcludeAssets="all" />
    <PackageReference Include="MemoryPack" Version="1.21.4" ExcludeAssets="all" />
    <PackageReference Include="MemoryPack.Core" Version="1.21.4" ExcludeAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.10" ExcludeAssets="all" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" ExcludeAssets="all" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" ExcludeAssets="all" />
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.8" ExcludeAssets="all" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" ExcludeAssets="all" />
    <PackageReference Include="Oodle.NET" Version="2.2.0" ExcludeAssets="all" />
    <PackageReference Include="OodleSharp" Version="0.0.1" ExcludeAssets="all" />
    <PackageReference Include="Zlib-ng.NET" Version="1.2.0" ExcludeAssets="all" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" ExcludeAssets="all" />
    <PackageReference Include="Berrysoft.XXTea" Version="4.0.9" ExcludeAssets="all" />
    <PackageReference Include="Blake3" Version="3.0.2" ExcludeAssets="all" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" ExcludeAssets="all" />
    <PackageReference Include="Serilog" Version="4.3.1" ExcludeAssets="all" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" ExcludeAssets="all" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" ExcludeAssets="all" />
    <EmbeddedResource Include="Assets\nexus-mods.png" LogicalName="Redout2ModManager.Assets.nexus-mods.png" />
    <EmbeddedResource Include="Assets\redout2-steam.jpg" LogicalName="Redout2ModManager.Assets.redout2-steam.jpg" />
    <EmbeddedResource Include="Assets\gamebanana.png" LogicalName="Redout2ModManager.Assets.gamebanana.png" />
    <EmbeddedResource Include="Assets\discord-icon.png" LogicalName="Redout2ModManager.Assets.discord-icon.png" />
  </ItemGroup>
</Project>

